# Existing MySQL database connection. Keep the real values in an untracked .env file.
DB_URL=jdbc:mysql://YOUR_HOST:3306/YOUR_DATABASE?useSSL=true&serverTimezone=UTC
DB_USERNAME=YOUR_DB_USERNAME
DB_PASSWORD=YOUR_DB_PASSWORD

# AWS: prefer an EC2/ECS IAM role in production. Do not commit access keys.
AWS_REGION=ap-south-1
AWS_SES_FROM_EMAIL=verified-sender@example.com
AWS_S3_BUCKET=your-private-document-bucket
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Aadhaar: leave blank until an authorized UIDAI-compliant provider is onboarded.
AADHAAR_PROVIDER_ENDPOINT=
AADHAAR_PROVIDER_CLIENT_ID=
AADHAAR_PROVIDER_CLIENT_SECRET=

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TRANSACTION_TOPIC=bank_transactions

# Admin Security & MFA Configuration
ADMIN_OTP_EXPIRY_SECONDS=300
ADMIN_OTP_MAX_ATTEMPTS=5
ADMIN_OTP_RESEND_COOLDOWN_SECONDS=60
ADMIN_SESSION_TIMEOUT_SECONDS=900
ADMIN_MAX_LOGIN_ATTEMPTS=5
ADMIN_LOCK_DURATION_MINUTES=15

# Super Admin Initial Provisioning (Used on Database Initialization)
SUPERADMIN_ID=SKMB9897
SUPERADMIN_USER=superadmin
SUPERADMIN_PASSWORD=change_this_secure_password_in_production
SUPERADMIN_EMAIL=admin@skminibank.com
SUPERADMIN_MOBILE=+919876543210

